---
import AuthorCard from '../../components/AuthorCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPaginatedPosts, getPublishedPosts } from '../../lib/content';
import { pageRoute, site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / 4));

  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) },
    props: {
      allPosts: posts,
      page: index + 1,
    },
  }));
}

const { allPosts, page } = Astro.props;
const pagination = getPaginatedPosts(allPosts, page, 4);
const title = page === 1 ? site.title : `Page ${page} — ${site.title}`;
---

<BaseLayout title={title} description={site.description} layout="home">
  <div class="page-flow grid-rule">
    <section class="archive-grid">
      <div>
        <div class="section-header reveal">
          <span class="section-label">Archive</span>
          <h1 class="section-title archive-title">More notebook entries.</h1>
          <p class="section-blurb">
            Same reading-first structure, just a little deeper in the archive.
            The notes stay lightweight and easy to scan.
          </p>
        </div>

        <div class="archive-list">
          {pagination.posts.map((post) => <PostCard post={post} />)}
        </div>

        <nav class="pagination" aria-label="Pagination">
          {
            pagination.currentPage > 1 ? (
              <a href={pagination.currentPage === 2 ? '/' : pageRoute(pagination.currentPage - 1)} rel="prev">
                Newer notes
              </a>
            ) : (
              <span aria-disabled="true">Newer notes</span>
            )
          }
          {
            pagination.currentPage < pagination.totalPages ? (
              <a href={pageRoute(pagination.currentPage + 1)} rel="next">Older notes</a>
            ) : (
              <span aria-disabled="true">Older notes</span>
            )
          }
        </nav>
      </div>

      <div class="section-note reveal reveal-delay">
        <AuthorCard variant="compact" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .archive-title {
    font-size: clamp(2.1rem, 1.75rem + 1.3vw, 3rem);
  }
</style>
