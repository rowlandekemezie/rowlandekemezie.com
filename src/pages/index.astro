---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import PostCard from '../components/PostCard.astro';
import { getPaginatedPosts, getPublishedPosts } from '../lib/content';
import { pageRoute, site } from '../lib/site';

const allPosts = await getPublishedPosts();
const pagination = getPaginatedPosts(allPosts, 1, 5);
const socialProfiles = site.author.links
  .map((link) => link.url)
  .filter((url) => url.startsWith('http'));
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.author.name,
  alternateName: 'rowlandekemezie.com',
  description: site.description,
  url: site.url,
  logo: new URL(site.logo, site.url).toString(),
  sameAs: socialProfiles,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'professional inquiries',
      email: site.author.email,
      url: new URL('/contact/', site.url).toString(),
      availableLanguage: ['English'],
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
};
---

<BaseLayout
  title={site.title}
  description={site.description}
  image={site.logo}
  layout="home"
  structuredData={organizationStructuredData}
>
  <div class="home-layout">
    <aside class="home-sidebar reveal">
      <HomeSidebar current="posts" />
    </aside>

    <section class="home-feed reveal reveal-delay">
      <div class="home-feed-list">
        {pagination.posts.map((post) => <PostCard post={post} />)}
      </div>

      <nav class="pagination" aria-label="Pagination">
        <span aria-disabled="true">← Prev</span>
        {
          pagination.totalPages > 1 && (
            <a href={pageRoute(2)} rel="next">Next →</a>
          )
        }
      </nav>
    </section>
  </div>
</BaseLayout>
