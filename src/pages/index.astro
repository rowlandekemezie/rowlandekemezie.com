---
import AuthorCard from '../components/AuthorCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPaginatedPosts, getPublishedPosts } from '../lib/content';
import { pageRoute, site } from '../lib/site';

const allPosts = await getPublishedPosts();
const pagination = getPaginatedPosts(allPosts, 1, 4);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="panel stack">
    <span class="eyebrow">Phase 1</span>
    <h1>Posts</h1>
    <p class="muted">
      Phase 1 is focused on route, content, and metadata parity while the site is rebuilt on Astro.
    </p>
    <div class="posts">
      {
        pagination.posts.map((post) => (
          <PostCard post={post} />
        ))
      }
    </div>
    {
      pagination.totalPages > 1 && (
        <nav class="pagination" aria-label="Pagination">
          <a href={pageRoute(1)} rel="next">Older posts</a>
        </nav>
      )
    }
  </section>
  <AuthorCard />
</BaseLayout>
