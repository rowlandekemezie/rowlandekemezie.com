---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingIntro from '../components/WritingIntro.astro';
import PostArchive from '../components/PostArchive.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/content';
import { site } from '../lib/site';

const featuredCount = 5;
const allPosts = await getPublishedPosts();
const featuredPosts = allPosts.slice(0, featuredCount);
const earlierPosts = allPosts.slice(featuredCount);
const socialProfiles = site.author.links
  .map((link) => link.url)
  .filter((url) => url.startsWith('http'));
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.author.name,
  alternateName: 'rowlandekemezie.com',
  description: site.description,
  url: site.url,
  logo: new URL(site.logo, site.url).toString(),
  sameAs: socialProfiles,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'professional inquiries',
      email: site.author.email,
      url: new URL('/contact/', site.url).toString(),
      availableLanguage: ['English'],
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
};
---

<BaseLayout
  title={site.title}
  description={site.description}
  image={site.logo}
  layout="home"
  structuredData={organizationStructuredData}
>
  <div class="home-layout">
    <div class="home-intro-wrap reveal">
      <WritingIntro posts={allPosts} />
    </div>

    <section class="home-feed reveal reveal-delay" aria-label="Latest writing">
      <div class="home-feed-list">
        {featuredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <PostArchive posts={earlierPosts} />
  </div>
</BaseLayout>
