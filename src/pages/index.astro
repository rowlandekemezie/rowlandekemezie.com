---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import PostCard from '../components/PostCard.astro';
import { getPaginatedPosts, getPublishedPosts } from '../lib/content';
import { pageRoute, site } from '../lib/site';

const allPosts = await getPublishedPosts();
const pagination = getPaginatedPosts(allPosts, 1, 4);
---

<BaseLayout title={site.title} description={site.description} layout="home">
  <HomeSidebar slot="sidebar" current="posts" />
  <div class="posts">
    {
      pagination.posts.map((post) => (
        <PostCard post={post} />
      ))
    }
  </div>
  {
    pagination.totalPages > 1 && (
      <nav class="pagination" aria-label="Pagination">
        <span aria-disabled="true">← Prev</span>
        <a href={pageRoute(2)} rel="next">Next →</a>
      </nav>
    )
  }
</BaseLayout>
