---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import ArticleTableOfContents from '../../components/ArticleTableOfContents.astro';
import EmailLink from '../../components/EmailLink.astro';
import PostTags from '../../components/PostTags.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPostDate,
  getPostExcerpt,
  getPostPath,
  getPostReadingMinutes,
  getSeriesBySlug,
  getSeriesForPost,
  getSeriesPosition,
  getPublishedPosts,
  parsePostDate,
} from '../../lib/content';
import { seriesRoute, site, trimSlashes } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: trimSlashes(getPostPath(post)).replace(/^posts\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const series = getSeriesForPost(post);
const seriesGroup = series ? getSeriesBySlug(allPosts, series.slug) : undefined;
const seriesPosition = seriesGroup ? getSeriesPosition(post, seriesGroup.posts) : -1;
const previousInSeries = seriesPosition > 0 ? seriesGroup?.posts[seriesPosition - 1] : undefined;
const nextInSeries =
  seriesGroup && seriesPosition >= 0 && seriesPosition < seriesGroup.posts.length - 1
    ? seriesGroup.posts[seriesPosition + 1]
    : undefined;
// Newer and older essays for the end-of-article "Keep reading" links.
const postIndex = allPosts.findIndex((candidate) => getPostPath(candidate) === getPostPath(post));
const newerPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 && postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : undefined;
const title = `${post.data.title} — ${site.title}`;
const canonical = new URL(getPostPath(post), site.url).toString();
const publishedTime = parsePostDate(post.data.date).toISOString();
const modifiedTime = post.data.updated ? parsePostDate(post.data.updated).toISOString() : publishedTime;
// Social networks reject very large images, so share a resized JPEG rather than the original.
const socialImagePath = post.data.image
  ? (await getImage({ src: post.data.image, width: Math.min(1200, post.data.image.width), format: 'jpeg', quality: 80 })).src
  : undefined;
const socialImage = socialImagePath ? new URL(socialImagePath, site.url).toString() : undefined;
const description = post.data.description ?? getPostExcerpt(post);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.author.name,
    url: new URL('/about/', site.url).toString(),
  },
  publisher: {
    '@id': `${site.url}/#person`,
  },
  inLanguage: 'en',
  ...(seriesGroup
    ? {
        isPartOf: {
          '@type': 'CreativeWorkSeries',
          name: seriesGroup.title,
          url: new URL(seriesRoute(seriesGroup.slug), site.url).toString(),
        },
        position: seriesPosition + 1,
      }
    : {}),
  mainEntityOfPage: canonical,
  url: canonical,
  ...(socialImage ? { image: [socialImage] } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={socialImage}
  layout="article"
  socialType="article"
  publishedTime={publishedTime}
  structuredData={articleStructuredData}
>
  <div class="page-flow">
    <article data-reading-article data-article-path={getPostPath(post)}>
      <div class="article-head reveal">
        <span class="eyebrow">{post.data.category ?? 'Essay'}</span>
        <h1>{post.data.title}</h1>
        {
          seriesGroup && seriesPosition >= 0 && (
            <p class="article-series">
              <a href={seriesRoute(seriesGroup.slug)}>{seriesGroup.title}</a>
              <span>Part {seriesPosition + 1} of {seriesGroup.posts.length}</span>
            </p>
          )
        }
        <p class="article-meta">
          <time datetime={publishedTime}>{formatPostDate(post.data.date)}</time>
          {post.data.updated && <span>Updated <time datetime={modifiedTime}>{formatPostDate(post.data.updated)}</time></span>}
          <span>{getPostReadingMinutes(post)} min read</span>
          <span data-reading-status>Unread</span>
        </p>
        {
          post.data.archived && (
            <p class="archived-note">
              <strong>Archived.</strong> I wrote this in {parsePostDate(post.data.date).getUTCFullYear()} and haven't
              updated it since. Some tools, links, and advice may be out of date.
            </p>
          )
        }
      </div>

      <div class="article-shell">
        <div class="article-main">
          <div class="prose reveal reveal-delay-2" data-reading-prose>
            <Content />
          </div>

          <section
            class="reading-completion"
            data-reading-completion
            aria-label="Reading progress"
            aria-live="polite"
            hidden
          >
            <div class="reading-completion-status">
              <span class="reading-completion-mark" aria-hidden="true">✓</span>
              <div class="reading-completion-done">
                <p class="reading-completion-label">Reading complete</p>
                <p class="reading-completion-note">Saved on this device.</p>
              </div>
              <div class="reading-completion-cleared">
                <p class="reading-completion-label">Marked unread</p>
                <p class="reading-completion-note">Your progress on this essay was cleared.</p>
              </div>
            </div>
            <button class="reading-control" type="button" data-reading-toggle hidden>Mark unread</button>
          </section>

          <section class="post-tags-section reveal reveal-delay-2">
            <PostTags tags={post.data.tags} />
          </section>

          {
            seriesGroup && seriesPosition >= 0 && (
              <section class="series-panel reveal reveal-delay-2" aria-labelledby="series-navigation-heading">
                <p class="series-kicker">Series</p>
                <h2 id="series-navigation-heading">{seriesGroup.title}</h2>
                <p class="series-summary">
                  Part {seriesPosition + 1} of {seriesGroup.posts.length}
                </p>
                <nav class="series-links" aria-label="Series navigation">
                  {
                    previousInSeries ? (
                      <a href={getPostPath(previousInSeries)}>← {previousInSeries.data.title}</a>
                    ) : (
                      <span aria-disabled="true">← Start of series</span>
                    )
                  }
                  <a href={seriesRoute(seriesGroup.slug)}>View series overview</a>
                  {
                    nextInSeries ? (
                      <a href={getPostPath(nextInSeries)}>{nextInSeries.data.title} →</a>
                    ) : (
                      <span aria-disabled="true">End of series →</span>
                    )
                  }
                </nav>
              </section>
            )
          }

          {
            (newerPost || olderPost) && (
              <nav class="keep-reading reveal reveal-delay-2" aria-labelledby="keep-reading-heading">
                <h2 id="keep-reading-heading">Keep reading</h2>
                <ul>
                  {newerPost && (
                    <li>
                      <span class="keep-reading-label">Newer</span>
                      <a href={getPostPath(newerPost)}>{newerPost.data.title}</a>
                    </li>
                  )}
                  {olderPost && (
                    <li>
                      <span class="keep-reading-label">Older</span>
                      <a href={getPostPath(olderPost)}>{olderPost.data.title}</a>
                    </li>
                  )}
                </ul>
              </nav>
            )
          }

          <section
            class="article-reply reveal reveal-delay-2"
            aria-labelledby="article-reply-heading"
            data-article-reply
          >
            <p class="article-reply-kicker">Reader mail</p>
            <h2 id="article-reply-heading">Have a thought?</h2>
            <p>Send me a question or tell me what I missed. I read every message.</p>
            <EmailLink
              class="article-reply-link"
              ariaLabel={`Reply to ${post.data.title} by email`}
              subject={`Re: ${post.data.title}`}
              title={`Email Rowland about ${post.data.title}`}
            >
              Reply by email <span aria-hidden="true">→</span>
            </EmailLink>
          </section>
        </div>

        <ArticleTableOfContents headings={headings} />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
  .article-main {
    min-width: 0;
  }

  .article-head h1 {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .reading-completion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.25rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
  }

  .reading-completion[hidden] {
    display: none;
  }

  .reading-completion:focus {
    outline: none;
  }

  .reading-completion:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .reading-completion-cleared,
  .reading-completion[data-reading-marked-unread] .reading-completion-done,
  .reading-completion[data-reading-marked-unread] .reading-completion-mark {
    display: none;
  }

  .reading-completion[data-reading-marked-unread] .reading-completion-cleared {
    display: block;
  }

  .archived-note {
    max-width: 46rem;
    margin: 0 0 1.35rem;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .keep-reading {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .keep-reading h2 {
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .keep-reading ul {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .keep-reading li {
    display: grid;
    gap: 0.25rem;
  }

  .keep-reading-label {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .keep-reading a {
    color: var(--heading);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .keep-reading a:hover,
  .keep-reading a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .keep-reading a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .reading-completion-status {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
  }

  .reading-completion-mark {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .reading-completion-label,
  .reading-completion-note {
    margin: 0;
  }

  .reading-completion-label {
    color: var(--text);
    font-weight: 700;
  }

  .reading-completion-note {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .reading-control {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    white-space: nowrap;
  }

  .reading-control:hover {
    color: var(--text);
  }

  .reading-control:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .reading-control:active {
    color: var(--text);
    text-decoration-thickness: 2px;
  }

  .reading-control:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .article-main :global(.prose h2),
  .article-main :global(.prose h3),
  .article-main :global(.prose h4) {
    scroll-margin-top: 4rem;
  }

  .article-main :global(.prose table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    line-height: 1.55;
    -webkit-overflow-scrolling: touch;
    /* Edge shadows appear only when the table is wider than the column and can scroll. */
    background:
      linear-gradient(to right, var(--bg) 30%, transparent) left / 2rem 100% no-repeat local,
      linear-gradient(to left, var(--bg) 30%, transparent) right / 2rem 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, color-mix(in srgb, var(--heading) 28%, transparent), transparent) left / 0.75rem 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, color-mix(in srgb, var(--heading) 28%, transparent), transparent) right / 0.75rem 100% no-repeat scroll;
  }

  .article-main :global(.prose th),
  .article-main :global(.prose td) {
    min-width: 9rem;
    padding: 0.75rem 0.85rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--line);
  }

  .article-main :global(.prose th) {
    background: var(--surface);
    font-weight: 700;
  }

  .article-main :global(.prose pre),
  .article-main :global(.prose .astro-code) {
    margin: 1rem 0 1.35rem;
    padding: 0.8rem 1rem !important;
    border-top-width: 1px !important;
    font-size: 0.92rem;
    line-height: 1.6;
    tab-size: 2;
  }

  .article-main :global(.prose pre:has(code.language-txt)),
  .article-main :global(.prose pre:has(code.language-text)) {
    padding-block: 0.65rem !important;
  }

  .post-tags-section {
    margin-top: 2rem;
  }

  .post-tags-section :global(.tag-list) {
    gap: 0.5rem;
  }

  .post-tags-section :global(.tag-list a) {
    min-height: 2rem;
    padding: 0 0.9375rem;
    color: var(--muted);
    font-size: 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    line-height: 2rem;
  }

  .post-tags-section :global(.tag-list a:hover),
  .post-tags-section :global(.tag-list a:focus-visible) {
    color: var(--text);
    border-color: var(--accent);
  }

  .article-series {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .article-series a {
    color: var(--accent);
    text-decoration: none;
  }

  .article-series a:hover,
  .article-series a:focus-visible {
    text-decoration: underline;
  }

  .series-panel {
    margin-top: 2rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .series-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .series-panel h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }

  .series-summary {
    margin: 0.55rem 0 0;
    color: var(--muted);
  }

  .series-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .series-links a,
  .series-links span {
    color: var(--muted);
    text-decoration: none;
  }

  .series-links a:hover,
  .series-links a:focus-visible {
    color: var(--accent);
  }

  .series-links span[aria-disabled='true'] {
    opacity: 0.55;
  }

  .article-reply {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .article-reply-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .article-reply h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .article-reply > p:not(.article-reply-kicker) {
    max-width: 38rem;
    margin: 0.65rem 0 0;
    color: var(--muted);
  }

  .article-reply :global(.article-reply-link) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.8rem;
    color: var(--accent);
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .article-reply :global(.article-reply-link span) {
    display: inline-block;
  }

  .article-reply :global(.article-reply-link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    /* Wider cells keep rows short; the table scrolls sideways with edge shadows as the cue. */
    .article-main :global(.prose th),
    .article-main :global(.prose td) {
      min-width: 13rem;
    }
  }

  @media (max-width: 30rem) {
    .reading-completion {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .reading-control {
      margin-left: 2.5rem;
    }
  }
</style>
