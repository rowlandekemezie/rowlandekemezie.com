---
import { render } from 'astro:content';
import AuthorCard from '../../components/AuthorCard.astro';
import DisqusComments from '../../components/DisqusComments.astro';
import PostTags from '../../components/PostTags.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPostDate,
  getPostExcerpt,
  getPostIdentifier,
  getPostPath,
  getPublishedPosts,
  parsePostDate,
} from '../../lib/content';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: getPostPath(post).replace(/^\/posts\/|\/$/g, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} — ${site.title}`;
const canonical = new URL(getPostPath(post), site.url).toString();
const publishedTime = parsePostDate(post.data.date).toISOString();
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: getPostExcerpt(post),
  datePublished: publishedTime,
  dateModified: publishedTime,
  author: {
    '@type': 'Person',
    name: site.author.name,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  ...(post.data.cover ? { image: [post.data.cover] } : {}),
};
---

<BaseLayout
  title={title}
  description={getPostExcerpt(post)}
  canonical={canonical}
  image={post.data.cover}
  socialType="article"
  publishedTime={publishedTime}
  structuredData={articleStructuredData}
>
  {
    post.data.cover && (
      <figure class="post-hero">
        <img src={post.data.cover} alt="" loading="eager" />
      </figure>
    )
  }
  <article class="panel stack post-detail">
    <span class="eyebrow">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="muted">{formatPostDate(post.data.date)}</p>
    <Content />
    <PostTags tags={post.data.tags} />
    <DisqusComments
      identifier={getPostIdentifier(post)}
      title={post.data.title}
      url={canonical}
    />
  </article>
  <AuthorCard />
</BaseLayout>
