---
import { render } from 'astro:content';
import PostTags from '../../components/PostTags.astro';
import ScrollTopButton from '../../components/ScrollTopButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPostDate,
  getPostExcerpt,
  getPostPath,
  getPublishedPosts,
  parsePostDate,
} from '../../lib/content';
import { site, trimSlashes } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: trimSlashes(getPostPath(post)).replace(/^posts\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} — ${site.title}`;
const canonical = new URL(getPostPath(post), site.url).toString();
const publishedTime = parsePostDate(post.data.date).toISOString();
const socialImage = post.data.image ? new URL(post.data.image.src, site.url).toString() : undefined;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: getPostExcerpt(post),
  datePublished: publishedTime,
  dateModified: publishedTime,
  author: {
    '@type': 'Person',
    name: site.author.name,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  ...(socialImage ? { image: [socialImage] } : {}),
};
---

<BaseLayout
  title={title}
  description={getPostExcerpt(post)}
  canonical={canonical}
  image={socialImage}
  layout="article"
  footerVariant="article"
  socialType="article"
  publishedTime={publishedTime}
  structuredData={articleStructuredData}
>
  <article class="post-detail">
    <h1>{post.data.title}</h1>
    <p class="post-meta-line muted">
      <span>{formatPostDate(post.data.date)}</span>
      <span>•</span>
      <span>{Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).length / 220))} min read</span>
    </p>
    <div class="prose">
      <Content />
    </div>
    <div class="post-bottom">
      <PostTags tags={post.data.tags} />
      <!-- <DisqusComments
        identifier={getPostIdentifier(post)}
        title={post.data.title}
        url={canonical}
      /> -->
    </div>
  </article>
  <ScrollTopButton />
</BaseLayout>

<style>
  .post-detail {
    text-align: center;
  }

  .post-detail h1 {
    max-width: 18ch;
    margin: 0 auto;
    font-size: clamp(2.7rem, 6vw, 4rem);
    letter-spacing: -0.05em;
    line-height: 1.12;
  }

  .post-meta-line {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-top: 1.8rem;
    font-style: italic;
  }

  .post-detail .prose {
    max-width: 39rem;
    margin: 0 auto;
    text-align: left;
  }

  .post-detail .prose :global(img),
  .post-detail .prose :global(img[data-image-component='true']) {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin: 0 auto !important;
  }

  .post-detail .prose :global(p > img:only-child),
  .post-detail .prose :global(picture) {
    display: block;
    margin: 0 auto;
  }

  .post-bottom {
    max-width: 39rem;
    margin: 2rem auto 0;
    text-align: left;
  }
  @media (max-width: 47.9375rem) {
    .post-detail h1 {
      font-size: 2.25rem;
    }
  }
</style>
