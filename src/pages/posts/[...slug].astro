---
import { render } from 'astro:content';
import AuthorCard from '../../components/AuthorCard.astro';
import DisqusComments from '../../components/DisqusComments.astro';
import PostTags from '../../components/PostTags.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPostDate,
  getPostExcerpt,
  getPostIdentifier,
  getPostPath,
  getPublishedPosts,
  parsePostDate,
} from '../../lib/content';
import { site, trimSlashes } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: trimSlashes(getPostPath(post)).replace(/^posts\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} — ${site.title}`;
const canonical = new URL(getPostPath(post), site.url).toString();
const publishedTime = parsePostDate(post.data.date).toISOString();
const socialImage = post.data.image ? new URL(post.data.image.src, site.url).toString() : undefined;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: getPostExcerpt(post),
  datePublished: publishedTime,
  dateModified: publishedTime,
  author: {
    '@type': 'Person',
    name: site.author.name,
  },
  mainEntityOfPage: canonical,
  url: canonical,
  ...(socialImage ? { image: [socialImage] } : {}),
};
---

<BaseLayout
  title={title}
  description={getPostExcerpt(post)}
  canonical={canonical}
  image={socialImage}
  layout="article"
  socialType="article"
  publishedTime={publishedTime}
  structuredData={articleStructuredData}
>
  <div class="page-flow">
    <section class="article-shell">
      <div>
        <div class="article-head reveal">
          <span class="eyebrow">{post.data.category ?? 'Essay'}</span>
          <h1>{post.data.title}</h1>
          <p class="article-lede">{getPostExcerpt(post, 220)}</p>
          <p class="article-meta">
            <span>{formatPostDate(post.data.date)}</span>
            <span>{Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).length / 220))} min read</span>
          </p>
        </div>

        {post.data.image && <figure class="article-cover reveal reveal-delay"><img src={post.data.image.src} alt="" loading="eager" /></figure>}

        <article class="prose reveal reveal-delay-2">
          <Content />
        </article>

        <div class="micro-panel" style="margin-top: 2rem;">
          <p><strong>Tags</strong></p>
          <PostTags tags={post.data.tags} />
        </div>

        <section style="margin-top: 3rem;">
          <DisqusComments
            identifier={getPostIdentifier(post)}
            title={post.data.title}
            url={canonical}
          />
        </section>
      </div>

      <aside class="article-rail reveal reveal-delay">
        <p class="eyebrow">Notebook context</p>
        <a class="list-link" href="/">Back to writing</a>
        <AuthorCard variant="compact" />
      </aside>
    </section>
  </div>
</BaseLayout>
