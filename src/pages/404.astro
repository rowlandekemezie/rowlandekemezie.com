---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout title={`Not Found — ${site.title}`} description={site.description}>
  <section class="panel stack">
    <span class="eyebrow">404</span>
    <h1>Page not found</h1>
    <p class="muted">
      The page you requested does not exist. Use the writing index or the machine-readable resources
      below to find a current route.
    </p>
    <ul class="taxonomy-list">
      <li><a href="/">Writing index</a></li>
      <li><a href="/sitemap.xml">XML sitemap</a></li>
      <li><a href="/llms.txt">llms.txt</a></li>
      <li><a href="/developers/">Developer resources</a></li>
    </ul>
  </section>
</BaseLayout>
