---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, systemPillars } from '../../lib/site';
---

<BaseLayout title={`About — ${site.title}`} description={site.description}>
  <section class="section">
    <div class="hero-grid">
      <div class="section-stack">
        <span class="eyebrow">About</span>
        <h1 style="font-size: clamp(2.3rem, 5vw, 4.6rem);">{site.author.name}</h1>
        <p class="lede">
          I work at the intersection of software, learning, and human systems. The goal is not just
          to ship code, but to build clearer loops around thinking, execution, and feedback.
        </p>
      </div>
      <aside class="section stack">
        <span class="eyebrow">Coordinates</span>
        <dl>
          <dt>Location</dt>
          <dd>{site.author.location}</dd>
        </dl>
        <dl>
          <dt>Best known for</dt>
          <dd>Systems thinking applied to software, writing, and team-level clarity.</dd>
        </dl>
        <dl>
          <dt>Contact</dt>
          <dd><a href={`mailto:${site.author.email}`}>{site.author.email}</a></dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <span class="eyebrow">The four systems</span>
    <div class="pillar-grid">
      {
        systemPillars.map((pillar) => (
          <section class="section stack">
            <h2 style="font-size: 1.35rem;">{pillar.label}</h2>
            <p>{pillar.blurb}</p>
            <ul class="taxonomy-list">
              {pillar.prompts.map((prompt) => <li>{prompt}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="split-line">
      <div class="section stack">
        <span class="eyebrow">How I work</span>
        <ul class="taxonomy-list">
          <li>Prefer clear structures over ornamental complexity.</li>
          <li>Use writing to make technical decisions legible.</li>
          <li>Care about the human systems around software, not only the code.</li>
        </ul>
      </div>
      <div class="section stack">
        <span class="eyebrow">What this site is for</span>
        <p class="muted">
          This portfolio is not split into a polished work page and a separate blog. It treats notes,
          essays, and shipped thinking as one connected body of work.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
