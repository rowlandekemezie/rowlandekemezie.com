---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPageBySlug } from '../../lib/content';
import { site } from '../../lib/site';

const page = await getPageBySlug('about');

if (!page) {
  throw new Error('Missing content/pages/about.md');
}

const { Content } = await render(page);
---

<BaseLayout title={`About — ${site.title}`} description={site.description} hideFooter={true}>
  <section class="about-page stack">
    <h1>{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    max-width: 40rem;
    margin: 0 auto;
  }

  .about-page h1 {
    text-align: center;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: -0.05em;
  }

  .about-page .prose {
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .about-page .prose :global(center) {
    margin-bottom: 2rem;
  }

  .about-page .prose :global(center img) {
    width: 18rem;
    max-width: 100%;
    border-radius: 999px;
  }
</style>
