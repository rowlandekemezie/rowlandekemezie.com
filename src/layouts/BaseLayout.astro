---
import { site } from '../lib/site';

interface Props {
  canonical?: string;
  description?: string;
  image?: string;
  title?: string;
}

const {
  canonical = site.url + Astro.url.pathname,
  description = site.description,
  image,
  title = site.title,
} = Astro.props;

const socialImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, site.url).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={`@${site.author.twitter}`} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4efe6;
        --text: #1f1610;
        --muted: #66584d;
        --accent: #b15e09;
        --card: rgba(255, 255, 255, 0.72);
        --border: rgba(31, 22, 16, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Georgia, 'Times New Roman', serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(177, 94, 9, 0.2), transparent 32rem),
          linear-gradient(180deg, #fbf6ee 0%, var(--bg) 100%);
      }

      a {
        color: inherit;
      }

      main {
        width: min(60rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 4rem 0 5rem;
      }

      .panel {
        padding: 2rem;
        border: 1px solid var(--border);
        border-radius: 1.5rem;
        background: var(--card);
        box-shadow: 0 1rem 3rem rgba(31, 22, 16, 0.08);
        backdrop-filter: blur(12px);
      }

      h1,
      h2,
      p {
        margin-top: 0;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .muted {
        color: var(--muted);
      }

      .stack > * + * {
        margin-top: 1rem;
      }

      .posts {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;
      }

      .post-card {
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.6);
      }

      .post-card h2 {
        margin-bottom: 0.4rem;
      }

      .post-card p:last-child {
        margin-bottom: 0;
      }

      .nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
      }

      .nav a {
        font-weight: 600;
        text-decoration: none;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }

      article :global(pre) {
        overflow-x: auto;
      }

      ul {
        padding-left: 1.25rem;
      }

      .taxonomy-list {
        display: grid;
        gap: 0.75rem;
        padding-left: 1.25rem;
      }

      .pagination {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 2rem;
      }

      .pagination a,
      .pagination span {
        padding: 0.55rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <main>
      <nav class="nav" aria-label="Primary">
        <a href="/">Posts</a>
        <a href="/tags/">Tags</a>
        <a href="/categories/">Categories</a>
      </nav>
      <slot />
    </main>
  </body>
</html>
