---
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  canonical?: string;
  description?: string;
  footerVariant?: 'default' | 'article';
  hideFooter?: boolean;
  image?: string;
  layout?: 'default' | 'home' | 'article';
  publishedTime?: string;
  socialType?: 'article' | 'website';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  title?: string;
}

const {
  canonical = new URL(Astro.url.pathname, site.url).toString(),
  description = site.description,
  footerVariant = 'default',
  hideFooter = false,
  image,
  layout = 'default',
  publishedTime,
  socialType = 'website',
  structuredData,
  title = site.title,
} = Astro.props;

const socialImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, site.url).toString()
  : undefined;

const defaultStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.title,
    description,
    url: site.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author.name,
    description: site.author.summary,
    url: site.url,
    sameAs: site.author.links.map((link) => link.url).filter((url) => url.startsWith('http')),
  },
];

const jsonLd = JSON.stringify(
  structuredData ? [...defaultStructuredData, ...[structuredData].flat()] : defaultStructuredData
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48x48.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS Feed`} href="/rss.xml" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={`@${site.author.twitter}`} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f5f0e7;
        --surface: rgba(255, 252, 247, 0.72);
        --text: #14110f;
        --muted: #72675d;
        --line: rgba(20, 17, 15, 0.12);
        --accent: #b5641d;
        --font-sans: "Avenir Next", "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
        --page-width: min(76rem, calc(100vw - 2rem));
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: var(--font-sans);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.65), rgba(255,255,255,0)) 0 0 / 100% 14rem no-repeat,
          linear-gradient(90deg, rgba(20,17,15,0.025) 1px, transparent 1px) center / min(76rem, calc(100vw - 2rem)) 100% no-repeat,
          var(--bg);
      }
      a { color: inherit; text-decoration-color: rgba(181, 100, 29, 0.45); text-underline-offset: 0.18em; }
      img { max-width: 100%; height: auto; }
      .site-header, .site-main, .site-footer { width: var(--page-width); margin: 0 auto; }
      .site-header { padding: 1.25rem 0 0; }
      .site-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3rem;
        border-bottom: 1px solid var(--line);
      }
      .site-brand {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
      .site-nav a { color: var(--muted); font-size: 0.95rem; text-decoration: none; }
      .site-nav a:hover,
      .site-nav a:focus-visible { color: var(--text); }
      .site-main { padding: 2rem 0 4rem; }
      .panel {
        padding: clamp(1.5rem, 2vw, 2rem);
        background: var(--surface);
        border: 1px solid var(--line);
      }
      .stack > * + * { margin-top: 1rem; }
      .muted { color: var(--muted); }
      .eyebrow {
        display: inline-block;
        margin: 0 0 0.9rem;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .lede {
        max-width: 36rem;
        font-size: clamp(1.05rem, 1.6vw, 1.2rem);
        line-height: 1.7;
        color: var(--muted);
      }
      .button-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.85rem;
        padding: 0.65rem 1rem;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #fff;
        text-decoration: none;
      }
      .button-link:hover,
      .button-link:focus-visible { background: #985111; }
      .subtle-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        text-decoration: none;
      }
      .subtle-link:hover,
      .subtle-link:focus-visible { color: var(--text); }
      .section-jumps,
      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0;
        margin: 0;
        list-style: none;
      }
      .section-jumps a,
      .tag-list a {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0 0.15rem;
        color: var(--muted);
        font-size: 0.95rem;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .section-jumps a:hover,
      .section-jumps a:focus-visible,
      .tag-list a:hover,
      .tag-list a:focus-visible { color: var(--text); border-bottom-color: var(--accent); }
      .posts { display: grid; gap: 1.75rem; }
      .pagination {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
      }
      .pagination a,
      .pagination span { color: var(--muted); font-size: 0.95rem; text-decoration: none; }
      .pagination a:hover,
      .pagination a:focus-visible { color: var(--accent); }
      .pagination span[aria-disabled='true'] { opacity: 0.4; }
      .taxonomy-list { display: grid; gap: 0.75rem; padding-left: 1rem; }
      .taxonomy-list a { text-decoration: none; }
      .taxonomy-list a:hover,
      .taxonomy-list a:focus-visible { color: var(--accent); }
      .prose {
        font-family: var(--font-serif);
        font-size: 1.08rem;
        line-height: 1.85;
        color: rgba(20, 17, 15, 0.96);
      }
      .prose > :first-child { margin-top: 0; }
      .prose h2,
      .prose h3,
      .prose h4 {
        margin: 2.4rem 0 1rem;
        font-family: var(--font-sans);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .prose h2 { font-size: clamp(1.65rem, 3vw, 2.1rem); }
      .prose h3 { font-size: 1.25rem; }
      .prose p,
      .prose ul,
      .prose ol,
      .prose blockquote,
      .prose pre,
      .prose table,
      .prose figure { margin: 1.2rem 0; }
      .prose blockquote {
        margin-left: 0;
        padding-left: 1.2rem;
        border-left: 2px solid var(--accent);
        color: var(--muted);
      }
      .prose ul,
      .prose ol { padding-left: 1.4rem; }
      .prose :global(a) { color: var(--accent); }
      .prose :global(pre),
      .prose :global(.astro-code) {
        overflow-x: auto;
        padding: 14px;
        background: #1f1f1f !important;
        color: #f7f4ef;
        border-top: 5px solid #2f2f2f;
      }
      .prose :global(pre code),
      .prose :global(.astro-code code) { padding: 0; background: transparent; }
      .reveal { animation: reveal-up 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
      @keyframes reveal-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .reveal { animation: none; } }
      @media (max-width: 56rem) {
        .site-header, .site-main, .site-footer { width: min(100vw - 1.5rem, 100%); }
      }
      @media (max-width: 40rem) {
        .site-header-bar { align-items: flex-start; flex-direction: column; padding-bottom: 0.9rem; }
        .site-nav { gap: 0.75rem 1rem; }
        .site-main { padding-top: 1.5rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-bar">
        <a class="site-brand" href="/">{site.title}</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Writing</a>
          <a href="/pages/about/">About</a>
          <a href="/tags/">Tags</a>
        </nav>
      </div>
    </header>
    <main class="site-main" data-layout={layout}>
      <slot />
    </main>
    {!hideFooter && <SiteFooter variant={footerVariant} />}
    <CloudflareAnalytics />
  </body>
</html>
