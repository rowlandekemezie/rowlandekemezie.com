---
import CloudflareAnalytics from '../components/CloudflareAnalytics.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import ScrollTopButton from '../components/ScrollTopButton.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  canonical?: string;
  description?: string;
  footerVariant?: 'default' | 'article';
  hideFooter?: boolean;
  image?: string;
  layout?: 'default' | 'home' | 'article';
  publishedTime?: string;
  socialType?: 'article' | 'website';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  title?: string;
}

const {
  canonical = new URL(Astro.url.pathname, site.url).toString(),
  description = site.description,
  footerVariant = 'default',
  hideFooter = false,
  image,
  layout = 'default',
  publishedTime,
  socialType = 'website',
  structuredData,
  title = site.title,
} = Astro.props;

const socialImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, site.url).toString()
  : undefined;

const defaultStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.title,
    description,
    url: site.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author.name,
    description: site.author.summary,
    url: site.url,
    sameAs: site.author.links.map((link) => link.url).filter((url) => url.startsWith('http')),
  },
];

const jsonLd = JSON.stringify(
  structuredData ? [...defaultStructuredData, ...[structuredData].flat()] : defaultStructuredData
);
const emailLinkScript =
  '(()=>{const i=()=>document.querySelectorAll("[data-email-link]").forEach((n)=>{if(!(n instanceof HTMLAnchorElement))return;const{eh,eu}=n.dataset;if(!eu||!eh)return;n.href="mai"+"lto:"+eu+"@"+eh});document.readyState==="loading"?document.addEventListener("DOMContentLoaded",i,{once:true}):i()})();';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS Feed`} href="/rss.xml" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={`@${site.author.twitter}`} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <script is:inline set:html={emailLinkScript}></script>
    <script src="/scripts/pwa-cache-reset.js" defer></script>
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f5f0e7;
        --surface: rgba(255, 252, 247, 0.72);
        --card: rgba(255, 255, 255, 0.55);
        --text: #14110f;
        --muted: #72675d;
        --line: rgba(20, 17, 15, 0.12);
        --accent: #b5641d;
        --font-sans: "Avenir Next", "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
        --page-width: min(76rem, calc(100vw - 2rem));
      }
      body.dark {
        --bg: #141618;
        --surface: rgba(18, 22, 27, 0.86);
        --card: #1d232b;
        --text: #f3f5f7;
        --muted: #c0c7d0;
        --line: rgba(255, 255, 255, 0.12);
        --accent: #b9833f;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--text);
        font-family: var(--font-sans);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.65), rgba(255,255,255,0)) 0 0 / 100% 14rem no-repeat,
          var(--bg);
      }
      body.dark {
        background:
          linear-gradient(180deg, rgba(8, 11, 14, 0.78), rgba(8, 11, 14, 0)) 0 0 / 100% 14rem no-repeat,
          var(--bg);
      }
      a { color: inherit; text-decoration-color: rgba(181, 100, 29, 0.45); text-underline-offset: 0.18em; }
      img { max-width: 100%; height: auto; }
      .site-header, .site-main {
        width: var(--page-width);
        max-width: 100%;
        min-width: 0;
        margin: 0 auto;
      }
      .site-header { padding: 1.25rem 0 0; }
      .site-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3rem;
        border-bottom: 1px solid var(--line);
      }
      .site-brand {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }
      .site-nav a { color: var(--muted); font-size: 0.95rem; text-decoration: none; }
      .site-nav a:hover,
      .site-nav a:focus-visible { color: var(--text); }
      .site-main {
        flex: 1 0 auto;
        padding: 2rem 0 4rem;
      }
      .home-layout {
        display: grid;
        gap: 1.875rem;
      }
      .home-sidebar {
        width: 100%;
      }
      .home-feed {
        width: 100%;
      }
      .home-sidebar h1 {
        margin: 0.95rem 0 0;
        font-size: clamp(2rem, 2.25vw, 2.45rem);
        line-height: 1.1;
      }
      .home-sidebar p {
        margin: 1.4rem 0 0;
        color: var(--text);
        font-size: clamp(1.05rem, 1.2vw, 1.25rem);
        line-height: 1.65;
      }
      .home-feed-list {
        display: grid;
        gap: 1.25rem;
      }
      @media (min-width: 685px) {
        .home-layout {
          grid-template-columns: minmax(15.75rem, 32%) minmax(0, 1fr);
          align-items: start;
        }
        .home-sidebar {
          position: sticky;
          top: 1.25rem;
          padding-right: 1.5rem;
        }
        .home-feed {
          border-left: 1px solid var(--line);
          padding-left: 2.2rem;
        }
      }
      .sidebar-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .avatar {
        width: 8.25rem;
        height: 8.25rem;
        border-radius: 50%;
        object-fit: cover;
      }
      .theme-toggle {
        position: relative;
        display: inline-flex;
        width: 5rem;
        height: 2.5rem;
        align-items: center;
        justify-content: space-between;
        border: 1px solid var(--line);
        border-radius: 6.25rem;
        background: #1e1f22;
        color: #fff;
        padding: 0 0.55rem;
        cursor: pointer;
      }
      .theme-knob {
        position: absolute;
        top: 0;
        left: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background: #fff;
        transition: transform 0.25s ease;
      }
      body.dark .theme-knob {
        transform: translateX(2.5rem);
      }
      .theme-icon {
        position: relative;
        z-index: 1;
        font-size: 1.25rem;
        line-height: 1;
      }
      .site-nav .theme-toggle {
        width: 3.7rem;
        height: 2rem;
        padding: 0 0.35rem;
        background: #25292e;
      }
      .site-nav .theme-toggle .theme-knob {
        width: 2rem;
        height: 2rem;
      }
      .site-nav .theme-toggle .theme-icon {
        font-size: 1rem;
      }
      body.dark .site-nav .theme-toggle .theme-knob {
        transform: translateX(1.7rem);
      }
      .home-links {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.65rem;
      }
      .home-links a {
        color: var(--text);
        text-decoration: none;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.625;
        border-bottom: 1px solid transparent;
        width: fit-content;
        cursor: pointer;
      }
      .home-links a:hover,
      .home-links a:focus-visible {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }
      .home-links a[aria-current='page'] {
        color: var(--text);
        border-bottom-color: var(--text);
      }
      .home-socials {
        margin: 2.5rem 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .home-socials li {
        margin: 0;
      }
      .home-socials a {
        width: 2.5rem;
        height: 2.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid var(--line);
        color: var(--muted);
      }
      .home-socials a svg {
        width: 1.35rem;
        height: 1.35rem;
      }
      .home-socials a:hover,
      .home-socials a:focus-visible {
        color: var(--text);
      }
      h1,
      h2,
      h3 {
        margin: 0;
        letter-spacing: -0.035em;
        line-height: 1.12;
      }
      h1 {
        font-size: clamp(2.15rem, 5.2vw, 4.2rem);
      }
      h2 {
        font-size: clamp(1.55rem, 3vw, 2.35rem);
      }
      .page-flow {
        display: grid;
        gap: clamp(2.8rem, 4vw, 4.4rem);
      }
      .page-flow > *,
      .hero-grid > *,
      .archive-grid > *,
      .home-section > *,
      .article-shell > *,
      .split-line > *,
      .page-grid > * {
        min-width: 0;
      }
      .grid-rule {
        position: relative;
      }
      .grid-rule::before {
        content: '';
        position: absolute;
        top: -1rem;
        left: 0;
        width: 100%;
        border-top: 1px solid var(--line);
      }
      .section-anchor {
        scroll-margin-top: 5rem;
      }
      .hero-grid,
      .archive-grid,
      .home-section,
      .article-shell,
      .split-line,
      .page-grid {
        display: grid;
        gap: clamp(1.2rem, 2vw, 2rem);
      }
      .hero-grid {
        grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.95fr);
        align-items: start;
      }
      .archive-grid,
      .home-section {
        grid-template-columns: minmax(0, 1.75fr) minmax(16rem, 0.9fr);
        align-items: start;
      }
      .article-shell {
        grid-template-columns: minmax(0, 1.85fr) minmax(16rem, 0.78fr);
        align-items: start;
      }
      .split-line {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .page-grid {
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      }
      .home-section {
        padding-top: clamp(1.35rem, 2vw, 2rem);
        border-top: 1px solid var(--line);
      }
      .section-header {
        max-width: 46rem;
      }
      .section-label {
        display: inline-block;
        margin-bottom: 0.7rem;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .section-title {
        margin: 0;
        line-height: 1.08;
      }
      .section-blurb {
        max-width: 40rem;
        margin: 0.95rem 0 0;
        color: var(--muted);
        line-height: 1.7;
      }
      .small-meta {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
        margin-top: 1rem;
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .small-meta span {
        position: relative;
        display: inline-flex;
        align-items: center;
      }
      .small-meta span + span::before {
        content: '•';
        margin-right: 0.45rem;
        color: rgba(114, 103, 93, 0.72);
      }
      .paper,
      .section,
      .micro-panel,
      .section-note,
      .hero-note {
        background: var(--surface);
      }
      .paper,
      .section,
      .micro-panel,
      .section-note {
        border: 1px solid var(--line);
      }
      .paper-inner,
      .section,
      .micro-panel,
      .section-note,
      .hero-note {
        padding: clamp(1.1rem, 2vw, 1.6rem);
      }
      .hero-note {
        margin-top: 1.1rem;
        border-left: 2px solid rgba(181, 100, 29, 0.5);
        color: var(--muted);
      }
      .hero-note p {
        margin: 0;
      }
      .hero-note p + p {
        margin-top: 0.45rem;
      }
      .section-stack > * + * {
        margin-top: 0.85rem;
      }
      .annotations {
        display: grid;
        gap: 0.65rem;
      }
      .annotation {
        margin: 0;
        padding-top: 0.7rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.65;
      }
      .annotation strong {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--text);
        font-size: 0.78rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .link-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.9rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .link-list a {
        color: var(--muted);
        text-decoration: none;
      }
      .link-list a:hover,
      .link-list a:focus-visible {
        color: var(--text);
      }
      .nav-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 1rem;
      }
      .nav-strip a {
        text-decoration: none;
      }
      .essay-list,
      .work-list,
      .archive-list {
        display: grid;
        gap: 0.35rem;
        margin-top: 1.2rem;
      }
      .section-note {
        color: var(--muted);
      }
      .section-note p {
        margin: 0;
      }
      .section-note p + p {
        margin-top: 0.55rem;
      }
      .section-note strong {
        color: var(--text);
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .list-link {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }
      .list-link:hover,
      .list-link:focus-visible {
        text-decoration: underline;
      }
      .article-head h1 {
        line-height: 1.04;
      }
      .article-lede {
        max-width: 48rem;
        margin: 1rem 0 0;
        color: var(--muted);
        line-height: 1.72;
      }
      .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin: 1rem 0 1.35rem;
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .article-cover {
        margin: 1.65rem 0;
      }
      .article-cover img {
        display: block;
        width: 100%;
        border: 1px solid var(--line);
      }
      .article-rail {
        position: sticky;
        top: 1.3rem;
        align-self: start;
        display: grid;
        gap: 0.95rem;
      }
      .pillar-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }
      dl {
        margin: 0;
      }
      dt {
        margin: 0;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      dd {
        margin: 0.45rem 0 0;
        line-height: 1.65;
      }
      .panel {
        padding: clamp(1.5rem, 2vw, 2rem);
        background: var(--surface);
        border: 1px solid var(--line);
      }
      .stack > * + * { margin-top: 1rem; }
      .muted { color: var(--muted); }
      .eyebrow {
        display: inline-block;
        margin: 0 0 0.9rem;
        color: var(--accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .lede {
        max-width: 36rem;
        font-size: clamp(1.05rem, 1.6vw, 1.2rem);
        line-height: 1.7;
        color: var(--muted);
      }
      .button-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.85rem;
        padding: 0.65rem 1rem;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #fff;
        text-decoration: none;
      }
      .button-link:hover,
      .button-link:focus-visible { background: #985111; }
      .subtle-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        text-decoration: none;
      }
      .subtle-link:hover,
      .subtle-link:focus-visible { color: var(--text); }
      .section-jumps,
      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0;
        margin: 0;
        list-style: none;
      }
      .section-jumps a,
      .tag-list a {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0 0.15rem;
        color: var(--muted);
        font-size: 0.95rem;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .section-jumps a:hover,
      .section-jumps a:focus-visible,
      .tag-list a:hover,
      .tag-list a:focus-visible { color: var(--text); border-bottom-color: var(--accent); }
      .posts { display: grid; gap: 1.75rem; }
      .pagination {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
      }
      .pagination a,
      .pagination span { color: var(--muted); font-size: 0.95rem; text-decoration: none; }
      .pagination a:hover,
      .pagination a:focus-visible { color: var(--accent); }
      .pagination span[aria-disabled='true'] { opacity: 0.4; }
      .pagination a,
      .pagination span {
        font-size: 1.625rem;
        font-weight: 700;
        letter-spacing: 0.01em;
      }
      .taxonomy-list { display: grid; gap: 0.75rem; padding-left: 1rem; }
      .taxonomy-list a { text-decoration: none; }
      .taxonomy-list a:hover,
      .taxonomy-list a:focus-visible { color: var(--accent); }
      .prose {
        max-width: 100%;
        min-width: 0;
        font-family: var(--font-serif);
        font-size: 1.08rem;
        line-height: 1.85;
        color: var(--text);
        overflow-wrap: break-word;
      }
      .prose > :first-child { margin-top: 0; }
      .prose img,
      .prose picture,
      .prose video,
      .prose canvas,
      .prose svg {
        display: block;
        max-width: 100%;
        height: auto;
      }
      .prose h2,
      .prose h3,
      .prose h4 {
        margin: 2.4rem 0 1rem;
        font-family: var(--font-sans);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      .prose h2 { font-size: clamp(1.65rem, 3vw, 2.1rem); }
      .prose h3 { font-size: 1.25rem; }
      .prose p,
      .prose ul,
      .prose ol,
      .prose blockquote,
      .prose pre,
      .prose table,
      .prose figure { margin: 1.2rem 0; }
      .prose > p:first-of-type img,
      .prose > figure:first-of-type img {
        width: 100%;
      }
      .prose blockquote {
        margin-left: 0;
        padding-left: 1.2rem;
        border-left: 2px solid var(--accent);
        color: var(--muted);
      }
      .prose ul,
      .prose ol { padding-left: 1.4rem; }
      .prose a { color: var(--accent); }
      .prose code:not(pre code) {
        padding: 0.1rem 0.35rem;
        border-radius: 0.2rem;
        background: rgba(20, 17, 15, 0.08);
        font-size: 0.95em;
      }
      body.dark .prose code:not(pre code) {
        background: rgba(255, 255, 255, 0.08);
      }
      .prose pre,
      .prose .astro-code {
        max-width: 100%;
        overflow-x: auto;
        padding: 14px !important;
        background: #1f1f1f !important;
        color: #f7f4ef;
        border-top: 5px solid #2f2f2f;
        border-radius: 6px;
      }
      .prose pre code,
      .prose .astro-code code {
        display: block;
        padding: 0 !important;
        background: transparent;
      }
      .prose .astro-code span {
        line-height: 1.65;
      }
      body.dark .prose pre,
      body.dark .prose .astro-code {
        border-top-color: #4a5563;
      }
      .prose pre:has(code.language-txt),
      .prose pre:has(code.language-text),
      .prose pre[data-language="txt"],
      .prose pre[data-language="text"],
      .prose .astro-code:has(code.language-txt),
      .prose .astro-code:has(code.language-text),
      .prose .astro-code[data-language="txt"],
      .prose .astro-code[data-language="text"] {
        background: rgba(20, 17, 15, 0.06) !important;
        color: var(--text) !important;
        border: 1px solid rgba(20, 17, 15, 0.1);
        border-top: 1px solid rgba(20, 17, 15, 0.1);
      }
      body.dark .prose pre:has(code.language-txt),
      body.dark .prose pre:has(code.language-text),
      body.dark .prose pre[data-language="txt"],
      body.dark .prose pre[data-language="text"],
      body.dark .prose .astro-code:has(code.language-txt),
      body.dark .prose .astro-code:has(code.language-text),
      body.dark .prose .astro-code[data-language="txt"],
      body.dark .prose .astro-code[data-language="text"] {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(255, 255, 255, 0.12);
      }
      .reveal { animation: reveal-up 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both; will-change: transform; }
      .reveal-delay { animation-delay: 100ms; }
      .reveal-delay-2 { animation-delay: 180ms; }
      @keyframes reveal-up { from { transform: translateY(18px); } to { transform: translateY(0); } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .reveal { animation: none; } }
      .dev-mode .reveal {
        animation: none;
      }
      @media (max-width: 70rem) {
        .hero-grid,
        .archive-grid,
        .home-section,
        .article-shell {
          grid-template-columns: minmax(0, 1fr);
        }
        .article-rail {
          position: static;
        }
      }
      @media (max-width: 58rem) {
        .page-grid,
        .split-line,
        .pillar-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (max-width: 56rem) {
        .site-header, .site-main { width: min(calc(100vw - 1.5rem), 100%); }
        .site-main {
          padding-bottom: 3rem;
        }
      }
      @media (max-width: 40rem) {
        .site-header-bar { align-items: flex-start; flex-direction: column; padding-bottom: 0.9rem; }
        .site-nav { gap: 0.75rem 1rem; }
        .site-main { padding-top: 1.5rem; }
        .paper-inner,
        .section,
        .micro-panel,
        .section-note,
        .hero-note {
          padding: 1rem;
        }
      }
    </style>
  </head>
  <body class:list={{ 'dev-mode': import.meta.env.DEV }}>
    <ScrollProgress />
    {layout !== 'home' && (
      <header class="site-header">
        <div class="site-header-bar">
          <a class="site-brand" href="/">{site.title}</a>
          <nav class="site-nav" aria-label="Primary">
            <a href="/">Writing</a>
            <a href="/series/">Series</a>
            <a href="/pages/about/">About</a>
            <a href="/tags/">Tags</a>
            <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
              <span class="theme-knob"></span>
              <span class="theme-icon theme-icon-moon" aria-hidden="true">🌙</span>
              <span class="theme-icon theme-icon-sun" aria-hidden="true">☀️</span>
            </button>
          </nav>
        </div>
      </header>
    )}
    <main class="site-main" data-layout={layout}>
      <slot />
    </main>
    {!hideFooter && <SiteFooter variant={footerVariant} />}
    <ScrollTopButton />
    <GoogleAnalytics />
    <CloudflareAnalytics />
    <script is:inline>
      (() => {
        const KEY = 'rowland.theme';
        const DARK = 'dark';
        const LIGHT = 'light';

        const getStoredTheme = () => {
          try {
            const value = window.localStorage.getItem(KEY);
            return value === DARK || value === LIGHT ? value : null;
          } catch {
            return null;
          }
        };

        const resolveTheme = () => {
          const stored = getStoredTheme();
          if (stored) return stored;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? DARK : LIGHT;
        };

        const applyTheme = (theme) => {
          document.body.classList.toggle(DARK, theme === DARK);
          document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
            if (el instanceof HTMLButtonElement) {
              el.setAttribute('aria-pressed', theme === DARK ? 'true' : 'false');
            }
          });
          window.dispatchEvent(new CustomEvent('rowland:theme-change', { detail: { theme } }));
        };

        const saveTheme = (theme) => {
          try {
            window.localStorage.setItem(KEY, theme);
          } catch {
            // no-op
          }
        };

        const init = () => {
          applyTheme(resolveTheme());

          document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
            if (!(el instanceof HTMLButtonElement)) return;

            el.addEventListener('click', () => {
              const nextTheme = document.body.classList.contains(DARK) ? LIGHT : DARK;
              applyTheme(nextTheme);
              saveTheme(nextTheme);
            });
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true });
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
