---
import avatar from '../assets/rowland-avatar.jpg';
import EmailLink from './EmailLink.astro';
import { site } from '../lib/site';

function iconId(label: string) {
  if (label === 'Twitter') return 'twitter';
  if (label === 'GitHub') return 'github';
  if (label === 'LinkedIn') return 'linkedin';
  if (label === 'Email') return 'email';
  return 'rss';
}
---

<section class="stack">
  <div class="sidebar-top">
    <img
      class="avatar"
      src={avatar.src}
      alt={site.author.name}
      width="300"
      height="300"
      loading="eager"
      decoding="async"
    />
  </div>
  <h1>{site.author.name}</h1>
  <p>{site.description}</p>
  <ul class="home-socials" aria-label="Social links">
    {
      site.author.links.map((link) => (
        <li>
          {link.label === 'Email' ? (
            <EmailLink ariaLabel={link.label} title={link.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <use href={`/icons/social-sprite.svg#${iconId(link.label)}`}></use>
              </svg>
            </EmailLink>
          ) : (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'noreferrer' : undefined}
              aria-label={link.label}
              title={link.label}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <use href={`/icons/social-sprite.svg#${iconId(link.label)}`}></use>
              </svg>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
