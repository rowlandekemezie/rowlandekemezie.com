---
import avatar from '../assets/rowland-avatar.jpg';
import EmailLink from './EmailLink.astro';
import { site } from '../lib/site';

interface Props {
  current?: 'posts' | 'about';
}

const { current = 'posts' } = Astro.props;

function icon(label: string) {
  if (label === 'Twitter') {
    return '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 7.2c.8-.1 1.5-.5 2.1-1.1-.3.9-.9 1.6-1.7 2.1v.5c0 4.8-3.7 10.4-10.4 10.4-2.1 0-4-.6-5.6-1.5h.9c1.7 0 3.3-.6 4.5-1.6-1.6 0-2.9-1.1-3.4-2.5h.6c.3 0 .7 0 1-.1-1.7-.3-3-1.8-3-3.6v-.1c.5.3 1.1.5 1.7.5-1-.7-1.7-1.9-1.7-3.2 0-.7.2-1.4.5-2 1.9 2.4 4.8 3.9 8 4-.1-.3-.1-.6-.1-.9 0-2.1 1.7-3.8 3.8-3.8 1.1 0 2.1.5 2.8 1.2Z"/></svg>';
  }

  if (label === 'GitHub') {
    return '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.6.5.5 5.7.5 12.1c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 .1.7 2.7 3.3 1.9.1-.7.4-1.2.7-1.5-2.5-.3-5.2-1.3-5.2-5.7 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1 .8 2.1v3.1c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.4.5 12 .5Z"/></svg>';
  }

  if (label === 'Email') {
    return '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.5h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Zm0 2v.2l9 6.3 9-6.3v-.2H3Zm18 9v-6.3l-8.4 5.9a1 1 0 0 1-1.2 0L3 10.2v6.3h18Z"/></svg>';
  }

  return '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 18.5A1.5 1.5 0 1 1 6 21.5A1.5 1.5 0 0 1 6 18.5Zm-1.5-7a8 8 0 0 1 8 8h-2a6 6 0 0 0-6-6v-2Zm0-4a12 12 0 0 1 12 12h-2a10 10 0 0 0-10-10v-2Z"/></svg>';
}
---

<section class="stack">
  <div class="sidebar-top">
    <img
      class="avatar"
      src={avatar.src}
      alt={site.author.name}
      width="300"
      height="300"
      loading="eager"
      decoding="async"
    />
    <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
      <span class="theme-knob"></span>
      <span class="theme-icon theme-icon-moon" aria-hidden="true">🌙</span>
      <span class="theme-icon theme-icon-sun" aria-hidden="true">☀️</span>
    </button>
  </div>
  <h1>{site.author.name}</h1>
  <p>{site.description}</p>
  <nav class="home-links" aria-label="Primary">
    <a href="/" aria-current={current === 'posts' ? 'page' : undefined}>Posts</a>
    <a href="/pages/about/" aria-current={current === 'about' ? 'page' : undefined}>About me</a>
  </nav>
  <ul class="home-socials" aria-label="Social links">
    {
      site.author.links.map((link) => (
        <li>
          {link.label === 'Email' ? (
            <EmailLink ariaLabel={link.label} title={link.label} html={icon(link.label)} />
          ) : (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'noreferrer' : undefined}
              aria-label={link.label}
              title={link.label}
              set:html={icon(link.label)}
            />
          )}
        </li>
      ))
    }
  </ul>
</section>
