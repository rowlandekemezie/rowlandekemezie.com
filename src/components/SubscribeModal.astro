<section class="subscribe-card" aria-labelledby="subscribe-title">
  <form class="subscribe-form" data-subscribe-form novalidate>
    <h3 id="subscribe-title" class="subscribe-header">Want more articles? Subscribe to my newsletter</h3>
    <div class="subscribe-inputwrapper">
      <label class="subscribe-label" for="subscribe-email">Email address:</label>
      <input
        id="subscribe-email"
        aria-label="your email address"
        aria-required="true"
        autocomplete="email"
        inputmode="email"
        name="email"
        placeholder="john@doe.com"
        required
        type="email"
        class="subscribe-input"
      />
    </div>
    <button type="submit" class="subscribe-button">Subscribe</button>
    <p class="subscribe-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script is:inline src="/scripts/subscribe-form.js"></script>

<style is:global>
  .subscribe-card {
    max-width: 21.875rem;
    background: var(--card);
    border: 1px solid var(--line);
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.875rem;
  }

  .subscribe-header {
    margin: 0 0 0.0625rem;
    color: var(--heading);
  }

  .subscribe-inputwrapper {
    width: 100%;
    margin: 0.625rem 0;
  }

  .subscribe-label {
    width: 100%;
    margin: 1.25rem 0;
    font-size: 1rem;
  }

  .subscribe-input {
    width: 100%;
    font-size: 1rem;
    padding: 0.625rem;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--bg);
    color: var(--text);
  }

  .subscribe-button {
    margin-top: 1.25rem;
    min-height: 2.75rem;
    font-size: 1rem;
    border-radius: 0;
    padding: 0.625rem 1.875rem;
    background-color: var(--accent);
    color: var(--accent-contrast);
    border: 1px solid var(--accent);
    cursor: pointer;
  }

  .subscribe-button:hover,
  .subscribe-button:focus-visible {
    background-color: transparent;
    color: var(--accent);
  }

  .subscribe-button:focus-visible,
  .subscribe-input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .kit-embed-shell {
    display: none;
  }

  .subscribe-status {
    min-height: 1.4rem;
    margin-top: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .subscribe-button:disabled,
  .subscribe-input:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  @media screen and (min-width: 685px) {
    .subscribe-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .subscribe-input,
    .subscribe-label {
      margin: 0.3125rem 0 0;
      border-radius: 0;
    }
  }
</style>
