---
const kitFormUid = import.meta.env.PUBLIC_KIT_FORM_UID?.trim();
const kitEmbedSrc = import.meta.env.PUBLIC_KIT_EMBED_SRC?.trim();
const hasKitConfig = Boolean(kitFormUid && kitEmbedSrc);
---

<section class="subscribe-card" aria-labelledby="subscribe-title">
  <div class="subscribe-form">
    <h3 id="subscribe-title" class="subscribe-header">Want more articles? Subscribe to my newsletter</h3>
    {
      hasKitConfig ? (
        <div class="kit-embed-shell">
          <script
            is:inline
            async
            data-uid={kitFormUid}
            src={kitEmbedSrc}
          ></script>
        </div>
      ) : (
        <>
          <div class="subscribe-inputwrapper">
            <label class="subscribe-label" for="subscribe-email">Email address:</label>
            <input
              id="subscribe-email"
              aria-label="your email address"
              aria-required="true"
              placeholder="john@doe.com"
              type="email"
              class="subscribe-input"
              disabled
            />
          </div>
          <button type="button" class="subscribe-button" disabled>Subscribe</button>
          <p class="subscribe-status" role="status">
            Configure `PUBLIC_KIT_EMBED_SRC` and `PUBLIC_KIT_FORM_UID` to enable signup.
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .subscribe-card {
    color: #fff;
    max-width: 21.875rem;
    background: #206aff;
    background-image: linear-gradient(-213deg, #5e31dc 0%, #3155dc 100%),
      linear-gradient(32deg, rgba(255, 255, 255, 0.25) 33%, rgba(0, 0, 0, 0.25) 100%);
    border-radius: 0.3125rem;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.875rem;
  }

  .subscribe-header {
    margin: 0 0 0.0625rem;
    color: #fff;
  }

  .subscribe-inputwrapper {
    width: 100%;
    margin: 0.625rem 0;
  }

  .subscribe-label {
    width: 100%;
    margin: 1.25rem 0;
    font-size: 1rem;
  }

  .subscribe-input {
    width: 100%;
    font-size: 1rem;
    padding: 0.625rem;
    box-sizing: border-box;
    border: none;
    border-radius: 0.1875rem;
  }

  .subscribe-button {
    margin-top: 1.25rem;
    font-size: 1rem;
    border-radius: 0.1875rem;
    padding: 0.625rem 1.875rem;
    background-color: #b15e09;
    color: #fff;
    border: none;
    cursor: pointer;
  }

  .subscribe-button:hover,
  .subscribe-button:focus-visible {
    background-color: #fff;
    color: #b15e09;
    border: 1px solid #b15e09;
  }

  .kit-embed-shell {
    width: 100%;
    margin-top: 1rem;
  }

  .kit-embed-shell :global(form) {
    margin: 0;
  }

  .subscribe-button:disabled,
  .subscribe-input:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .subscribe-status {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
  }

  @media screen and (min-width: 685px) {
    .subscribe-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .subscribe-input,
    .subscribe-label {
      margin: 0.3125rem 0 0;
      border-radius: 0.1875rem;
      border: none;
    }
  }
</style>
