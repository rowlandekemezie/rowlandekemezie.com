<section class="subscribe-card" aria-labelledby="subscribe-title">
  <form class="subscribe-form" data-subscribe-form novalidate>
    <h3 id="subscribe-title" class="subscribe-header">Want more articles? Subscribe to my newsletter</h3>
    <div class="subscribe-inputwrapper">
      <label class="subscribe-label" for="subscribe-email">Email address:</label>
      <input
        id="subscribe-email"
        aria-label="your email address"
        aria-required="true"
        autocomplete="email"
        inputmode="email"
        name="email"
        placeholder="john@doe.com"
        required
        type="email"
        class="subscribe-input"
      />
    </div>
    <button type="submit" class="subscribe-button">Subscribe</button>
    <p class="subscribe-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script is:inline>
  (() => {
    const forms = document.querySelectorAll('[data-subscribe-form]');

    for (const form of forms) {
      if (!(form instanceof HTMLFormElement)) continue;

      const emailInput = form.querySelector('input[name="email"]');
      const submitButton = form.querySelector('button[type="submit"]');
      const status = form.querySelector('.subscribe-status');

      if (
        !(emailInput instanceof HTMLInputElement) ||
        !(submitButton instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      ) {
        continue;
      }

      const setPending = (pending) => {
        emailInput.disabled = pending;
        submitButton.disabled = pending;
        submitButton.textContent = pending ? 'Subscribing...' : 'Subscribe';
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = '';

        if (!emailInput.value.trim()) {
          status.textContent = 'Enter your email address.';
          return;
        }

        setPending(true);

        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              email: emailInput.value.trim(),
              referrer: window.location.href,
            }),
          });

          const payload = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error(
              typeof payload?.error === 'string'
                ? payload.error
                : 'Something went wrong. Try again.'
            );
          }

          status.textContent =
            typeof payload?.message === 'string'
              ? payload.message
              : 'Check your inbox to confirm your subscription.';
          form.reset();
        } catch (error) {
          status.textContent =
            error instanceof Error ? error.message : 'Something went wrong. Try again.';
        } finally {
          setPending(false);
        }
      });
    }
  })();
</script>

<style>
  .subscribe-card {
    color: #fff;
    max-width: 21.875rem;
    background: #206aff;
    background-image: linear-gradient(-213deg, #5e31dc 0%, #3155dc 100%),
      linear-gradient(32deg, rgba(255, 255, 255, 0.25) 33%, rgba(0, 0, 0, 0.25) 100%);
    border-radius: 0.3125rem;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.875rem;
  }

  .subscribe-header {
    margin: 0 0 0.0625rem;
    color: #fff;
  }

  .subscribe-inputwrapper {
    width: 100%;
    margin: 0.625rem 0;
  }

  .subscribe-label {
    width: 100%;
    margin: 1.25rem 0;
    font-size: 1rem;
  }

  .subscribe-input {
    width: 100%;
    font-size: 1rem;
    padding: 0.625rem;
    box-sizing: border-box;
    border: none;
    border-radius: 0.1875rem;
  }

  .subscribe-button {
    margin-top: 1.25rem;
    font-size: 1rem;
    border-radius: 0.1875rem;
    padding: 0.625rem 1.875rem;
    background-color: #b15e09;
    color: #fff;
    border: none;
    cursor: pointer;
  }

  .subscribe-button:hover,
  .subscribe-button:focus-visible {
    background-color: #fff;
    color: #b15e09;
    border: 1px solid #b15e09;
  }

  .kit-embed-shell {
    display: none;
  }

  .subscribe-status {
    min-height: 1.4rem;
    margin-top: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
  }

  .subscribe-button:disabled,
  .subscribe-input:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  @media screen and (min-width: 685px) {
    .subscribe-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .subscribe-input,
    .subscribe-label {
      margin: 0.3125rem 0 0;
      border-radius: 0.1875rem;
      border: none;
    }
  }
</style>
