---
import type { PostEntry } from '../lib/content';
import { formatPostMonthYear, getPostExcerpt, getPostPath } from '../lib/content';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const excerpt = post.data.description ?? getPostExcerpt(post, 165);
---

<article class="post-card stack-sm">
  <p class="post-card-meta">
    <span>{formatPostMonthYear(post.data.date).toUpperCase()}</span>
    <span>{post.data.category ?? 'Uncategorized'}</span>
  </p>
  <h2 class="post-card-title">
    <a href={getPostPath(post)}>{post.data.title}</a>
  </h2>
  <p class="post-card-excerpt">{excerpt}</p>
  <p class="post-card-read">
    <a href={getPostPath(post)}>Read →</a>
  </p>
</article>

<style>
  .post-card {
    padding: 1.85rem 1.95rem 1.8rem;
    border: 1px solid rgba(31, 35, 40, 0.1);
    border-radius: 0.45rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
  }

  .post-card-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-card-meta span:last-child {
    color: #b8681a;
  }

  .post-card-title {
    font-size: clamp(1.55rem, 2.8vw, 1.95rem);
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .post-card-title a {
    color: #1f2328;
    text-decoration: none;
  }

  .post-card-title a:visited {
    color: #1f2328;
  }

  .post-card-title a:hover {
    color: #2563eb;
  }

  .post-card-excerpt {
    font-size: 0.98rem;
    line-height: 1.6;
    color: #1f2328;
  }

  .post-card-read a {
    color: #2563eb;
    font-weight: 500;
    text-decoration: none;
  }

  .post-card-read a:hover {
    text-decoration: underline;
  }

  @media (max-width: 47.9375rem) {
    .post-card {
      padding: 1.35rem 1.4rem;
    }

    .post-card-title {
      font-size: 1.55rem;
    }
  }
</style>
