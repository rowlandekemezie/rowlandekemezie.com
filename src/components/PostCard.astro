---
import type { PostEntry } from '../lib/content';
import { formatPostMonthYear, getPostExcerpt, getPostPath } from '../lib/content';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const excerpt = post.data.description ?? getPostExcerpt(post, 165);
---

<article class="post-card stack-sm">
  <p class="post-card-meta">
    <span>{formatPostMonthYear(post.data.date).toUpperCase()}</span>
    <span>{post.data.category ?? 'Uncategorized'}</span>
  </p>
  <h2 class="post-card-title">
    <a href={getPostPath(post)}>{post.data.title}</a>
  </h2>
  <p class="post-card-excerpt">{excerpt}</p>
  <p class="post-card-read">
    <a href={getPostPath(post)}>Read →</a>
  </p>
</article>

<style>
  .post-card {
    padding: 1.5rem 1.65rem 1.45rem;
    border: 1px solid var(--border);
    border-radius: 0.2rem;
    background: var(--card);
    box-shadow: none;
  }

  .post-card-meta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-card-meta span:last-child {
    color: var(--accent);
  }

  .post-card-title {
    font-size: clamp(1.24rem, 2.05vw, 1.68rem);
    letter-spacing: -0.03em;
    line-height: 1.22;
  }

  .post-card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card-title a:visited {
    color: var(--text);
  }

  .post-card-title a:hover {
    color: var(--link);
  }

  .post-card-excerpt {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-card-read a {
    color: var(--link);
    font-weight: 500;
    font-size: 0.93rem;
    text-decoration: none;
  }

  .post-card-read a:hover {
    text-decoration: underline;
  }

  @media (max-width: 47.9375rem) {
    .post-card {
      padding: 1.25rem 1.3rem;
    }

    .post-card-title {
      font-size: 1.45rem;
    }
  }
</style>
