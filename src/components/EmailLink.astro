---
import { site } from '../lib/site';

interface Props {
  ariaLabel?: string;
  class?: string;
  subject?: string;
  title?: string;
}

const { ariaLabel, class: className, subject, title } = Astro.props;
const [emailUser, emailHost] = site.author.email.split('@');
---

<a
  href="#"
  class={className}
  data-email-link
  data-eu={emailUser}
  data-eh={emailHost}
  data-es={subject ? encodeURIComponent(subject) : undefined}
  aria-label={ariaLabel}
  title={title}
>
  <slot />
</a>
