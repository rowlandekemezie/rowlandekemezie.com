---
import { aboutRoute, site } from '../lib/site';
---

<footer class="paper">
  <div class="paper-inner page-grid">
    <div class="section-stack">
      <span class="eyebrow">Direct contact</span>
      <h2>Interested in software systems, thoughtful writing, or a hard problem worth untangling?</h2>
      <p class="lede">
        The simplest route is still the best one. Send a note, share what you are building, or point me to the problem that needs judgment.
      </p>
      <div class="nav-strip">
        <a href={`mailto:${site.author.email}`}>Email Rowland</a>
        <a href={aboutRoute()}>About</a>
      </div>
    </div>
    <div class="section-stack">
      <span class="eyebrow">Elsewhere</span>
      <ul class="link-list" aria-label="Footer links">
        <li><a href="/">Home</a></li>
        <li><a href="/page/1/">Essays</a></li>
        <li><a href="/tags/">Tags</a></li>
        <li><a href="/categories/">Categories</a></li>
      </ul>
      <ul class="link-list" aria-label="Social links">
        {
          site.author.links.map((link) => (
            <li>
              <a
                href={link.url}
                target={link.url.startsWith('http') ? '_blank' : undefined}
                rel={link.url.startsWith('http') ? 'noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted">{site.titleAlt}</p>
    </div>
  </div>
</footer>
