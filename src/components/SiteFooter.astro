---
import EmailLink from './EmailLink.astro';
import SubscribeModal from './SubscribeModal.astro';
import { site } from '../lib/site';
const currentYear = new Date().getFullYear();

function iconId(label: string) {
  if (label === 'Twitter') return 'twitter';
  if (label === 'GitHub') return 'github';
  if (label === 'Email') return 'email';
  return 'rss';
}
---

<footer class="site-footer">
  <div class="site-footer-wrapper">
    <div class="site-footer-subscribe reveal">
      <SubscribeModal />
    </div>
    <div class="site-footer-meta reveal reveal-delay">
      <ul class="site-footer-socials" aria-label="Social links">
        {
          site.author.links.map((link) => (
            <li>
              {link.label === 'Email' ? (
                <EmailLink ariaLabel={link.label} title={link.label}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <use href={`/icons/social-sprite.svg#${iconId(link.label)}`}></use>
                  </svg>
                </EmailLink>
              ) : (
                <a
                  href={link.url}
                  target={link.url.startsWith('http') ? '_blank' : undefined}
                  rel={link.url.startsWith('http') ? 'noreferrer' : undefined}
                  aria-label={link.label}
                  title={link.label}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <use href={`/icons/social-sprite.svg#${iconId(link.label)}`}></use>
                  </svg>
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="site-footer-copyright">© {currentYear} rowlandekemezie</p>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer {
    margin-top: 4.375rem;
    padding: 0 0 3.25rem;
    background: #0e1319;
    color: #fff;
  }

  .site-footer-wrapper {
    width: min(78rem, calc(100vw - 2rem));
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding-top: 0;
  }

  .site-footer-subscribe {
    justify-self: start;
    margin-top: -2.75rem;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .site-footer-meta {
    display: grid;
    gap: 1rem;
    align-content: center;
  }

  .site-footer-socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-footer-socials li {
    margin: 0;
  }

  .site-footer-socials a {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.82);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0.9;
    text-decoration: none;
  }

  .site-footer-socials a :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .site-footer-socials a:hover,
  .site-footer-socials a:focus-visible {
    opacity: 1;
    border-color: #fff;
    transform: translateY(-1px);
  }

  .site-footer-copyright {
    margin: 0;
    color: #a2aab2;
    font-size: 0.875rem;
  }

  :global(body.dark) .site-footer {
    background: #090d12;
  }

  @media (min-width: 685px) {
    .site-footer-wrapper {
      grid-template-columns: minmax(18rem, 22rem) minmax(0, 1fr);
      min-height: 9rem;
      gap: 2rem;
      padding-top: 0;
    }

    .site-footer-meta {
      justify-items: start;
      padding-top: 2.5rem;
    }
  }

  @media (max-width: 56rem) {
    .site-footer-wrapper {
      width: min(100vw - 1.5rem, 100%);
    }
  }

  @media (max-width: 43rem) {
    .site-footer {
      padding-bottom: 2rem;
    }

    .site-footer-wrapper {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-footer-subscribe {
      margin-top: -2rem;
      margin-bottom: 0.5rem;
    }

    .site-footer-meta {
      padding-top: 0.5rem;
    }
  }
</style>
