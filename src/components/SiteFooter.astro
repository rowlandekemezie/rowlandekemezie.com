---
import { aboutRoute, site, systemPillars } from '../lib/site';
---

<footer class="section" style="margin-top: 1.5rem;">
  <div class="grid-two">
    <div class="section-stack">
      <span class="eyebrow">System close</span>
      <h2 style="margin-bottom: 0.6rem;">A minimal portfolio, organized by how the work actually happens.</h2>
      <p class="lede" style="font-size: 1rem;">
        The surface stays spare on purpose: fewer flourishes, clearer signals, and an archive that keeps writing and execution in the same map.
      </p>
      <div class="pillars-nav" style="margin-top: 1rem;">
        {systemPillars.map((pillar) => <a href={`/#${pillar.id}`}>{pillar.label}</a>)}
      </div>
    </div>
    <div class="section stack">
      <span class="eyebrow">Navigate</span>
      <ul class="link-list" aria-label="Footer links">
        <li><a href="/">Map</a></li>
        <li><a href="/page/1/">Archive</a></li>
        <li><a href={aboutRoute()}>About</a></li>
        <li><a href="/tags/">Tags</a></li>
        <li><a href="/categories/">Categories</a></li>
      </ul>
      <ul class="link-list" aria-label="Social links">
        {
          site.author.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="muted" style="margin-bottom: 0;">{site.titleAlt}</p>
    </div>
  </div>
</footer>
