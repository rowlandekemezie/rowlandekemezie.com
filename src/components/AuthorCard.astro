---
import { site, systemPillars } from '../lib/site';
---

<aside class="section">
  <div class="hero-grid">
    <div class="section-stack">
      <span class="eyebrow">Portrait</span>
      <div class="split-line">
        <div>
          <h2>{site.author.name}</h2>
          <p class="lede">{site.positioning}</p>
        </div>
        <div class="section stack">
          <p class="muted">Current location</p>
          <p><strong>{site.author.location}</strong></p>
          <p class="muted">Primary mode</p>
          <p>Software engineering with a systems lens.</p>
        </div>
      </div>
    </div>
    <div class="section stack">
      <span class="eyebrow">Links</span>
      <ul class="link-list" aria-label="Author links">
        {
          site.author.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="muted">
        The work here is organized as a system map: build, write, think, and lead.
      </p>
    </div>
  </div>
  <div class="pillar-grid" style="margin-top: 1rem;">
    {
      systemPillars.map((pillar) => (
        <section class="section stack" id={`pillar-${pillar.id}`}>
          <span class="eyebrow">{pillar.label}</span>
          <p>{pillar.blurb}</p>
          <ul class="taxonomy-list">
            {pillar.prompts.map((prompt) => <li>{prompt}</li>)}
          </ul>
        </section>
      ))
    }
  </div>
</aside>
