<button type="button" class="scroll-top-button" data-scroll-top hidden>
  <span class="scroll-top-icon" aria-hidden="true">↑</span>
  <span class="scroll-top-label">Scroll to top</span>
</button>

<script is:inline>
  (() => {
    const init = () => {
      const button = document.querySelector('[data-scroll-top]');
      if (!(button instanceof HTMLButtonElement)) return;

      const sync = () => {
        button.hidden = window.scrollY < 560;
      };

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      button.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        // Move keyboard focus with the scroll, so the next Tab starts at the top of the content.
        const main = document.getElementById('main');
        if (main instanceof HTMLElement) main.focus({ preventScroll: true });
      });

      window.addEventListener('scroll', sync, { passive: true });
      sync();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .scroll-top-button {
    position: fixed;
    right: 2rem;
    bottom: 1.75rem;
    z-index: 20;
    min-height: 2.75rem;
    color: var(--accent-contrast);
    background-color: var(--accent);
    padding: 0.8125rem 1rem;
    font-weight: 500;
    border: 1px solid var(--accent);
    border-radius: 0.25rem;
    cursor: pointer;
  }

  .scroll-top-button:hover,
  .scroll-top-button:focus-visible {
    background: transparent;
    color: var(--accent);
  }

  .scroll-top-button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .scroll-top-icon {
    display: none;
  }

  /* On phones a text button covers the reading column, so collapse it to a small round icon. */
  @media (max-width: 47.9375rem) {
    .scroll-top-button {
      right: 0.75rem;
      bottom: 0.75rem;
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      padding: 0;
      border-radius: 50%;
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
    }

    .scroll-top-button[hidden] {
      display: none;
    }

    .scroll-top-icon {
      display: block;
      font-size: 1.25rem;
      line-height: 1;
    }

    .scroll-top-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
