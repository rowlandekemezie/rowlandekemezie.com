---
interface Props {
  identifier: string;
  title: string;
  url: string;
}

const { identifier, title, url } = Astro.props;
const shortname = 'rowlandekemezie';

const configScript = `
  window.disqus_config = function () {
    this.page.url = ${JSON.stringify(url)};
    this.page.identifier = ${JSON.stringify(identifier)};
    this.page.title = ${JSON.stringify(title)};
  };
`;

const embedScript = `
  (function () {
    const d = document;
    const s = d.createElement('script');
    s.src = 'https://${shortname}.disqus.com/embed.js';
    s.setAttribute('data-timestamp', String(+new Date()));
    (d.head || d.body).appendChild(s);
  })();
`;
---

<section class="stack">
  <h2>Comments</h2>
  <div id="disqus_thread"></div>
  <script is:inline set:html={configScript}></script>
  <script is:inline set:html={embedScript}></script>
  <noscript>Please enable JavaScript to view the comments powered by Disqus.</noscript>
</section>
