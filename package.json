{
  "version": "1.0.0",
  "name": "rowland-i-ekemezie",
  "description": "Personal blog for Rowland Ekemezie",
  "main": "n/a",
  "scripts": {
    "dev": "astro dev",
    "develop": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro:check": "astro check",
    "verify:content-assets": "node scripts/verify-content-image-paths.mjs",
    "verify:analytics": "node scripts/verify-analytics-integration.mjs",
    "verify:dist": "node scripts/verify-static-output.mjs",
    "verify:launch-gates": "node scripts/verify-launch-gates.mjs",
    "verify:all": "yarn astro:check && yarn verify:content-assets && yarn build && yarn verify:dist && yarn verify:launch-gates",
    "clean": "rimraf .astro dist"
  },
  "repository": "https://github.com/rowlandekemezie/rowlandekemezie.com",
  "author": "Rowland I. Ekemezie <rowlandresource@gmail.com>",
  "license": "MIT",
  "keywords": [
    "blog",
    "astro",
    "cloudflare",
    "static-site",
    "disqus"
  ],
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "astro": "^6.1.10",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "husky": "^1.3.1",
    "lint-staged": "^8.1.5",
    "prettier": "^1.16.4",
    "rimraf": "2.6.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,json,md}": [
      "prettier --semi=true --single-quote --write",
      "git add"
    ]
  }
}
