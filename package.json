{
  "version": "1.0.0",
  "name": "rowland-i-ekemezie",
  "packageManager": "pnpm@10.22.0",
  "description": "Personal blog for Rowland Ekemezie",
  "main": "n/a",
  "scripts": {
    "dev": "astro dev",
    "develop": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro:check": "astro check",
    "lint": "pnpm lint:oxlint",
    "lint:oxlint": "oxlint --deny-warnings --node-plugin scripts src",
    "verify:content-assets": "node scripts/verify-content-image-paths.mjs",
    "verify:analytics": "node scripts/verify-analytics-integration.mjs",
    "verify:dist": "node scripts/verify-static-output.mjs",
    "verify:launch-gates": "node scripts/verify-launch-gates.mjs",
    "lighthouse:local": "node scripts/run-lighthouse.mjs",
    "lighthouse:preview": "node scripts/run-lighthouse.mjs https://concept-signal-desk.rowlandekemezie-com.pages.dev",
    "verify:all": "pnpm lint && pnpm astro:check && pnpm verify:content-assets && pnpm build && pnpm verify:dist && pnpm verify:launch-gates",
    "clean": "rimraf .astro dist"
  },
  "repository": "https://github.com/rowlandekemezie/rowlandekemezie.com",
  "author": "Rowland I. Ekemezie <rowlandresource@gmail.com>",
  "license": "MIT",
  "keywords": [
    "blog",
    "astro",
    "cloudflare",
    "static-site",
    "disqus"
  ],
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "astro": "^7.1.0",
    "mermaid": "^11.15.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "husky": "^1.3.1",
    "lighthouse": "^13.3.0",
    "lint-staged": "^8.1.5",
    "oxlint": "^1.65.0",
    "prettier": "^1.16.4",
    "rimraf": "2.6.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,mjs,ts}": [
      "oxlint --deny-warnings --node-plugin",
      "prettier --semi=true --single-quote --write",
      "git add"
    ],
    "**/*.{json,md}": [
      "prettier --semi=true --single-quote --write",
      "git add"
    ]
  }
}
